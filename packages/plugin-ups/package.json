    "./requests/rating/types": {
      "types": "./dist/requests/rating/types.d.ts",
      "default": "./dist/requests/rating/types.js"
    },
    "./requests/shipping/index": {
      "types": "./dist/requests/shipping/index.d.ts",
      "default": "./dist/requests/shipping/index.js"
    },
    "./requests/shipping/types": {
      "types": "./dist/requests/shipping/types.d.ts",
      "default": "./dist/requests/shipping/types.js"
    }
