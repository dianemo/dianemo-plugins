{
  "name": "@dianemo/plugin-stripe",
  "version": "2.0.0",
  "description": "Stripe plugin — payment intents, refunds, and webhooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./requests": {
      "types": "./dist/requests/index.d.ts",
      "default": "./dist/requests/index.js"
    },
    "./requests/customers": {
      "types": "./dist/requests/customers/index.d.ts",
      "default": "./dist/requests/customers/index.js"
    },
    "./requests/encode": {
      "types": "./dist/requests/encode.d.ts",
      "default": "./dist/requests/encode.js"
    },
    "./requests/index": {
      "types": "./dist/requests/index.d.ts",
      "default": "./dist/requests/index.js"
    },
    "./requests/paymentIntents": {
      "types": "./dist/requests/paymentIntents/index.d.ts",
      "default": "./dist/requests/paymentIntents/index.js"
    },
    "./requests/paymentMethods": {
      "types": "./dist/requests/paymentMethods/index.d.ts",
      "default": "./dist/requests/paymentMethods/index.js"
    },
    "./requests/refunds": {
      "types": "./dist/requests/refunds/index.d.ts",
      "default": "./dist/requests/refunds/index.js"
    },
    "./requests/setupIntents": {
      "types": "./dist/requests/setupIntents/index.d.ts",
      "default": "./dist/requests/setupIntents/index.js"
    },
    "./requests/types": {
      "types": "./dist/requests/types.d.ts",
      "default": "./dist/requests/types.js"
    },
    "./requests/customers/index": {
      "types": "./dist/requests/customers/index.d.ts",
      "default": "./dist/requests/customers/index.js"
    },
    "./requests/paymentIntents/index": {
      "types": "./dist/requests/paymentIntents/index.d.ts",
      "default": "./dist/requests/paymentIntents/index.js"
    },
    "./requests/paymentMethods/index": {
      "types": "./dist/requests/paymentMethods/index.d.ts",
      "default": "./dist/requests/paymentMethods/index.js"
    },
    "./requests/refunds/index": {
      "types": "./dist/requests/refunds/index.d.ts",
      "default": "./dist/requests/refunds/index.js"
    },
    "./requests/setupIntents/index": {
      "types": "./dist/requests/setupIntents/index.d.ts",
      "default": "./dist/requests/setupIntents/index.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist",
    "docs",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "stripe",
    "payments",
    "dianemo",
    "dianemo-plugin",
    "rate-limit"
  ],
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@dianemo/core": "^2.0.0",
    "@dianemo/plugin-kit": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianemo/dianemo-plugins.git",
    "directory": "packages/plugin-stripe"
  },
  "publishConfig": {
    "access": "public"
  }
}
