{
  "name": "@dianemo/plugin-kit",
  "version": "1.0.1",
  "description": "Shared toolkit for dianemo plugins — handler binding and cross-integration value types",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist",
    "docs",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "dianemo",
    "dianemo-plugin",
    "currency-codes",
    "iso-4217"
  ],
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@dianemo/core": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianemo/dianemo-plugins.git",
    "directory": "packages/plugin-kit"
  },
  "publishConfig": {
    "access": "public"
  }
}
