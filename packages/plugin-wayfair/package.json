{
  "name": "@dianemo/plugin-wayfair",
  "version": "1.0.1",
  "description": "Wayfair plugin — dropship purchase orders",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./requests": {
      "types": "./dist/requests/index.d.ts",
      "default": "./dist/requests/index.js"
    },
    "./requests/handleGraphQLRequest": {
      "types": "./dist/requests/handleGraphQLRequest.d.ts",
      "default": "./dist/requests/handleGraphQLRequest.js"
    },
    "./requests/index": {
      "types": "./dist/requests/index.d.ts",
      "default": "./dist/requests/index.js"
    },
    "./requests/inventory": {
      "types": "./dist/requests/inventory/index.d.ts",
      "default": "./dist/requests/inventory/index.js"
    },
    "./requests/orders": {
      "types": "./dist/requests/orders/index.d.ts",
      "default": "./dist/requests/orders/index.js"
    },
    "./requests/types": {
      "types": "./dist/requests/types.d.ts",
      "default": "./dist/requests/types.js"
    },
    "./requests/inventory/index": {
      "types": "./dist/requests/inventory/index.d.ts",
      "default": "./dist/requests/inventory/index.js"
    },
    "./requests/inventory/types": {
      "types": "./dist/requests/inventory/types.d.ts",
      "default": "./dist/requests/inventory/types.js"
    },
    "./requests/orders/index": {
      "types": "./dist/requests/orders/index.d.ts",
      "default": "./dist/requests/orders/index.js"
    },
    "./requests/orders/types": {
      "types": "./dist/requests/orders/types.d.ts",
      "default": "./dist/requests/orders/types.js"
    },
    "./requests/utils/gqlString": {
      "types": "./dist/requests/utils/gqlString.d.ts",
      "default": "./dist/requests/utils/gqlString.js"
    }
  },
  "files": [
    "LICENSE",
    "NOTICE",
    "README.md",
    "dist",
    "docs",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "wayfair",
    "marketplace",
    "dropship",
    "dianemo",
    "dianemo-plugin",
    "rate-limit"
  ],
  "author": "Aaron Leman",
  "license": "Apache-2.0",
  "peerDependencies": {
    "@dianemo/core": "^1.0.0",
    "@dianemo/plugin-kit": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dianemo/dianemo-plugins.git",
    "directory": "packages/plugin-wayfair"
  },
  "publishConfig": {
    "access": "public"
  }
}
