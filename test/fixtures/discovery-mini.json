{
  "kind": "discovery#restDescription",
  "name": "mini",
  "version": "v1",
  "schemas": {
    "Zeta": {
      "id": "Zeta",
      "type": "object",
      "description": "A zeta thing.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name."
        },
        "count": {
          "type": "integer",
          "format": "int32"
        },
        "ratio": {
          "type": "number",
          "format": "double"
        },
        "big": {
          "type": "string",
          "format": "int64",
          "description": "A big number."
        },
        "flag": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "alphas": {
          "type": "array",
          "items": {
            "$ref": "Alpha"
          }
        },
        "alpha": {
          "$ref": "Alpha"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extras": {
          "type": "object",
          "additionalProperties": {
            "type": "any"
          }
        },
        "anything": {
          "type": "any",
          "description": "Free form."
        },
        "blob": {
          "type": "object"
        },
        "mode": {
          "type": "string",
          "enum": [
            "MODE_UNSPECIFIED",
            "FAST",
            "SLOW"
          ],
          "enumDescriptions": [
            "x",
            "y",
            "z"
          ]
        },
        "old": {
          "type": "string",
          "deprecated": true,
          "description": "Use name."
        }
      }
    },
    "Alpha": {
      "id": "Alpha",
      "type": "object",
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "any"
            }
          }
        }
      }
    },
    "Empty": {
      "id": "Empty",
      "type": "object",
      "description": "Nothing.",
      "properties": {}
    }
  }
}